# CUDA 12.4 / Torch 2.5.1 training image for Qwen3.5 SFT.
# vLLM is intentionally excluded; current releases pin CUDA 13 Torch.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_ENABLE_HF_TRANSFER=0 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn \
    PYTHONUNBUFFERED=1

RUN python -m pip uninstall -y ninja || true
RUN python -m pip install --no-cache-dir --no-deps \
      "transformers==5.16.1" "peft==0.20.0" "trl==1.12.0" \
 && python -m pip install --no-cache-dir \
      "accelerate>=1.4.0,<2" "datasets>=4.7.0,<5" \
      "huggingface_hub>=1.5.0,<2" "tokenizers==0.23.1" \
      "safetensors==0.8.0" "jinja2>=3.1" "packaging>=24" \
      "regex>=2025.10.22" "sentencepiece>=0.2" "tqdm>=4.60" \
      "pyyaml>=6" "fsspec>=2023.1" "xxhash" "dill" "multiprocess" \
      "typer>=0.16,<1" \
 && python -m pip check \
 && python - <<'PY'
import torch, transformers, peft, trl
assert torch.__version__.startswith('2.5.1'), torch.__version__
assert torch.version.cuda == '12.4', torch.version.cuda
print('torch', torch.__version__, 'cuda', torch.version.cuda)
print('transformers', transformers.__version__, 'peft', peft.__version__, 'trl', trl.__version__)
PY

WORKDIR /workspace
CMD ["bash"]
